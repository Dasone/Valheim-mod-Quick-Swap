<Project>
  <PropertyGroup>
    <!-- Where Valheim is installed (the folder containing valheim.exe). -->
    <ValheimDir>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>

    <!-- r2modman data root. -->
    <R2ModManDir>C:\Users\samue\AppData\Roaming\r2modmanPlus-local</R2ModManDir>

    <!-- Which r2modman profile to build against and deploy into. -->
    <R2Profile>Valheim 1.0</R2Profile>

    <!-- false: build to bin/ only and leave the game profile alone. -->
    <Deploy>true</Deploy>

    <!-- true:  deploy into BepInEx/scripts/  (ScriptEngine reloads it live)
         false: deploy into BepInEx/plugins/QuickSwap/ (restart Valheim to load)
         Either can also be passed per build, e.g. -p:HotReload=false. -->
    <HotReload>true</HotReload>
  </PropertyGroup>
</Project>
