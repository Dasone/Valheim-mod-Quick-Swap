<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Valheim's Unity 6 Mono runtime speaks the .NET Framework profile. -->
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>QuickSwap</AssemblyName>
    <RootNamespace>QuickSwap</RootNamespace>
    <Product>Quick Swap</Product>
    <Description>Toggle between your last two used Valheim hotbar slots, plus an anchored slot.</Description>
    <Version>1.0.0</Version>
    <Authors>Dasone</Authors>
    <Company>Dasone</Company>
    <LangVersion>latest</LangVersion>

    <!-- Mono reads portable PDBs; this gives real line numbers in BepInEx stack traces. -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- A BepInEx plugin is a bare DLL: no deps.json, no ref assembly, no
         NuGet payload copied next to it. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- MSB3277: Unity ships several assemblies at conflicting versions; harmless here. -->
    <NoWarn>$(NoWarn);MSB3277;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <ThunderstoreDir>$(MSBuildThisFileDirectory)..\Thunderstore\</ThunderstoreDir>
    <ThunderstoreManifest>$(ThunderstoreDir)manifest.json</ThunderstoreManifest>
    <PackageIcon>$(ThunderstoreDir)icon.png</PackageIcon>
    <PackageReadme>$(MSBuildThisFileDirectory)..\README.md</PackageReadme>
    <PackageChangelog>$(MSBuildThisFileDirectory)..\CHANGELOG.md</PackageChangelog>
    <PackageDistDir>$(MSBuildThisFileDirectory)..\dist\</PackageDistDir>

    <!-- Read out of the files themselves, so the Package target can prove the three
         version numbers agree instead of trusting whoever last bumped one of them. -->
    <PluginSource>$(MSBuildThisFileDirectory)QuickSwapPlugin.cs</PluginSource>
    <ManifestVersion Condition="Exists('$(ThunderstoreManifest)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ThunderstoreManifest)')), '"version_number"\s*:\s*"([^"]+)"').Groups[1].Value)</ManifestVersion>
    <PluginModVersion Condition="Exists('$(PluginSource)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(PluginSource)')), 'ModVersion\s*=\s*"([^"]+)"').Groups[1].Value)</PluginModVersion>
  </PropertyGroup>

  <ItemGroup Label="Build-time only">
    <!-- Lets us compile net462 without Visual Studio's targeting packs installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Publicizes the game assemblies below so private/internal/protected members
         (InventoryGrid.Element, HotkeyBar.m_elements, Player.TakeInput, ...) are
         reachable from mod code. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Label="Valheim game assemblies">
    <Reference Include="$(ValheimManagedDir)\assembly_valheim.dll" Publicize="true" Private="false" />
    <Reference Include="$(ValheimManagedDir)\assembly_utils.dll" Publicize="true" Private="false" />
  </ItemGroup>

  <ItemGroup Label="Unity engine assemblies">
    <Reference Include="$(ValheimManagedDir)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(ValheimManagedDir)\Unity.*.dll" Private="false" />
    <Reference Include="$(ValheimManagedDir)\netstandard.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Label="Modding stack (from the active r2modman profile)">
    <Reference Include="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Label="Art">
    <!-- Embedded so the mod stays a single DLL with no loose asset files to deploy.
         Regenerate with: python art/make_icon.py -->
    <EmbeddedResource Include="Assets\anchor-arrows.png" LogicalName="QuickSwap.anchor-arrows.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Directory.Build.props" Link="Directory.Build.props" />
    <None Include="..\README.md" Link="README.md" />
  </ItemGroup>

  <!-- Bakes the build timestamp into the assembly, so the startup log line can prove
       which DLL is actually running after a hot reload. Regenerated every build. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoPath>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoPath>
      <BuildStamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</BuildStamp>
    </PropertyGroup>
    <ItemGroup>
      <BuildInfoLine Include="// &lt;auto-generated /&gt; Rewritten on every build - do not edit." />
      <BuildInfoLine Include="namespace QuickSwap" />
      <BuildInfoLine Include="{" />
      <BuildInfoLine Include="    internal static class BuildInfo" />
      <BuildInfoLine Include="    {" />
      <BuildInfoLine Include="        internal const string BuildTime = &quot;$(BuildStamp)&quot;%3B" />
      <BuildInfoLine Include="        internal const string Configuration = &quot;$(Configuration)&quot;%3B" />
      <BuildInfoLine Include="    }" />
      <BuildInfoLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoPath)" Lines="@(BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="false" />
    <ItemGroup>
      <Compile Include="$(BuildInfoPath)" />
      <FileWrites Include="$(BuildInfoPath)" />
    </ItemGroup>
  </Target>

  <Target Name="VerifyPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ValheimManagedDir)\assembly_valheim.dll')"
           Text="Valheim assemblies not found: $(ValheimManagedDir). Set &lt;ValheimDir&gt; in Environment.props." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')"
           Text="BepInEx not found: $(BepInExCoreDir). Install BepInEx in the '$(R2Profile)' r2modman profile, or set &lt;R2Profile&gt; in Environment.props." />
  </Target>

  <!-- ==================================================================
       Deploy
       dotnet build                      -> BepInEx/scripts/   (ScriptEngine reload)
       dotnet build -p:HotReload=false   -> BepInEx/plugins/QuickSwap/
       dotnet build -p:Deploy=false      -> no copy at all

       Each target clears the other location first: two copies of the same
       BepInPlugin GUID is a conflict, not a choice, and which one wins is not
       something to rely on.
       ================================================================== -->
  <Target Name="DeployHotReload" AfterTargets="Build"
          Condition="'$(Deploy)' != 'false' And '$(HotReload)' != 'false'">
    <Delete Files="$(PluginDeployDir)\$(AssemblyName).dll;$(PluginDeployDir)\$(AssemblyName).pdb" ContinueOnError="true" />
    <MakeDir Directories="$(ScriptsDeployDir)" />
    <Copy SourceFiles="$(TargetPath);@(_DebugSymbolsIntermediatePath)"
          DestinationFolder="$(ScriptsDeployDir)" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Message Importance="high" Text="-&gt; Hot-reloaded $(AssemblyName).dll into $(ScriptsDeployDir) (ScriptEngine picks it up in ~1.5s)" />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build"
          Condition="'$(Deploy)' != 'false' And '$(HotReload)' == 'false'">
    <Delete Files="$(ScriptsDeployDir)\$(AssemblyName).dll;$(ScriptsDeployDir)\$(AssemblyName).pdb" ContinueOnError="true" />
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath);@(_DebugSymbolsIntermediatePath)"
          DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Message Importance="high" Text="-&gt; Installed $(AssemblyName).dll in $(PluginDeployDir) (restart Valheim to load)" />
  </Target>

  <!-- ==================================================================
       Package
       dotnet build QuickSwap/QuickSwap.csproj -t:Package
       -> dist/QuickSwap-<version>.zip, ready to upload to Thunderstore.

       Builds Release through a nested MSBuild rather than depending on Build, so
       Configuration is forced and Deploy is forced off: packaging must never quietly
       swap the DLL you are playing with for a different configuration.
       ================================================================== -->
  <Target Name="Package">
    <Error Condition="'$(Version)' != '$(ManifestVersion)'"
           Text="Version mismatch: csproj is '$(Version)' but Thunderstore/manifest.json is '$(ManifestVersion)'. Bump them together." />
    <Error Condition="'$(Version)' != '$(PluginModVersion)'"
           Text="Version mismatch: csproj is '$(Version)' but ModVersion in QuickSwapPlugin.cs is '$(PluginModVersion)'. Bump them together." />
    <Error Condition="!Exists('$(PackageIcon)')"
           Text="Icon not found: $(PackageIcon). Thunderstore requires a 256x256 icon.png - run 'python art/make_icon.py'." />
    <Error Condition="!Exists('$(PackageChangelog)')"
           Text="Changelog not found: $(PackageChangelog). Thunderstore renders CHANGELOG.md as its own tab, and a release with no entry is worse than no tab at all." />

    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="Configuration=Release;Deploy=false">
      <Output TaskParameter="TargetOutputs" ItemName="_PackagedAssembly" />
    </MSBuild>

    <PropertyGroup>
      <PackageStageDir>$(MSBuildThisFileDirectory)obj\package\</PackageStageDir>
      <PackageZip>$(PackageDistDir)$(AssemblyName)-$(Version).zip</PackageZip>
    </PropertyGroup>

    <!-- Staged from scratch every time, so a renamed or deleted file cannot linger
         in the zip from a previous run. -->
    <RemoveDir Directories="$(PackageStageDir)" />
    <MakeDir Directories="$(PackageStageDir);$(PackageStageDir)plugins;$(PackageDistDir)" />

    <Copy SourceFiles="$(ThunderstoreManifest);$(PackageReadme);$(PackageChangelog);$(PackageIcon)"
          DestinationFolder="$(PackageStageDir)" />
    <Copy SourceFiles="@(_PackagedAssembly)" DestinationFolder="$(PackageStageDir)plugins" />

    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZip)" />
    <Message Importance="high" Text="-&gt; Packaged $(PackageZip)" />
  </Target>

</Project>
