<Project>
  <PropertyGroup>
    <!-- Root of the Valheim install (the folder containing valheim.exe). -->
    <ValheimDir>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>

    <!-- BepInEx folder the build deploys into. For r2modman this is inside the profile. -->
    <BepInExProfileDir>$(AppData)\r2modmanPlus-local\Valheim\profiles\Valheim 1.0\BepInEx</BepInExProfileDir>
  </PropertyGroup>
</Project>
